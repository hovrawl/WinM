<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <StartupObject>WinManager.Windows.Tests.TestWindowProgram</StartupObject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WinManager.Windows\WinManager.Windows.csproj" />
    <ProjectReference Include="..\..\src\WinManager.Client\WinManager.Client.csproj" />
    <ProjectReference Include="..\..\src\WinManager.Host\WinManager.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\WinManager.Recovery\WinManager.Recovery.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.360" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyRecoveryHelper" AfterTargets="Build">
    <ItemGroup>
      <RecoveryFiles Include="..\..\src\WinManager.Recovery\bin\$(Configuration)\net10.0-windows\*" />
    </ItemGroup>
    <Copy SourceFiles="@(RecoveryFiles)" DestinationFolder="$(OutDir)Recovery" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RecoveryFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyActualHost" AfterTargets="Build">
    <ItemGroup>
      <ActualHostFiles Include="..\..\src\WinManager.Host\bin\$(Configuration)\net10.0-windows\**\*" />
      <ActualHostRecoveryFiles Include="..\..\src\WinManager.Recovery\bin\$(Configuration)\net10.0-windows\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ActualHostFiles)" DestinationFiles="@(ActualHostFiles->'$(OutDir)ActualHost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ActualHostRecoveryFiles)" DestinationFolder="$(OutDir)ActualHost" SkipUnchangedFiles="true" />
  </Target>
</Project>