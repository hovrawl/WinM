<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>HomeDeskManager</AssemblyName>
    <AssemblyTitle>HomeDeskManager</AssemblyTitle>
    <Product>HomeDeskManager</Product>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <Import Project="..\..\scripts\AvaloniaSingleFile.props" />
  <ItemGroup>
    <ProjectReference Include="..\HomeDesk.Contracts\HomeDesk.Contracts.csproj" />
    <ProjectReference Include="..\HomeDesk.Ui\HomeDesk.Ui.csproj" />
    <ProjectReference Include="..\HomeDesk.Windows\HomeDesk.Windows.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="AvaloniaMcp.Diagnostics" Version="0.4.0" PrivateAssets="all" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.5" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.1" />
  </ItemGroup>
  <Import Project="..\..\scripts\AvaloniaSingleFile.targets" />
</Project>
