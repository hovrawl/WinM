<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>HomeDeskSpace</AssemblyName>
    <AssemblyTitle>HomeDeskSpace</AssemblyTitle>
    <Product>HomeDeskSpace</Product>
    <RootNamespace>WinManager.Host</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWin32PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x64</CsWin32PlatformTarget>
    <DefineConstants Condition="'$(PublishAot)' == 'true'">$(DefineConstants);WINMANAGER_HOST_AOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HomeDesk.Windows\HomeDesk.Windows.csproj" />
    <ProjectReference Include="..\HomeDesk.Recovery\HomeDesk.Recovery.csproj" ReferenceOutputAssembly="false"
                      Condition="'$(PublishAot)' != 'true'" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.360" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyRecoveryHelper" AfterTargets="Build" BeforeTargets="GetCopyToPublishDirectoryItems"
          Condition="'$(PublishAot)' != 'true'">
    <MSBuild Projects="..\HomeDesk.Recovery\HomeDesk.Recovery.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="RecoveryTarget" />
    </MSBuild>
    <PropertyGroup>
      <RecoveryDirectory>@(RecoveryTarget->'%(RootDir)%(Directory)')</RecoveryDirectory>
    </PropertyGroup>
    <ItemGroup>
      <RecoveryFiles Include="$(RecoveryDirectory)HomeDesk.Recovery.*" />
      <Content Include="@(RecoveryFiles)" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Copy SourceFiles="@(RecoveryFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyPublishedRecoveryHelper" AfterTargets="Publish" DependsOnTargets="CopyRecoveryHelper"
          Condition="'$(PublishAot)' != 'true'">
    <Error Condition="!Exists('$(RecoveryDirectory)HomeDesk.Recovery.dll')" Text="Recovery helper assembly is missing." />
    <Copy SourceFiles="@(RecoveryFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>