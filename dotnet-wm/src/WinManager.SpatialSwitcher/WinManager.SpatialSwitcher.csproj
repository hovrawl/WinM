<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <Import Project="..\..\scripts\AvaloniaSingleFile.props" />
  <ItemGroup>
    <ProjectReference Include="..\WinManager.Contracts\WinManager.Contracts.csproj" />
    <ProjectReference Include="..\WinManager.Ui\WinManager.Ui.csproj" />
    <ProjectReference Include="..\WinManager.Windows\WinManager.Windows.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="AvaloniaMcp.Diagnostics" Version="0.4.0" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\..\scripts\AvaloniaSingleFile.targets" />
</Project>
